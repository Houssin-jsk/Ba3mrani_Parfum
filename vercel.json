{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install --prefix client",
  "rewrites": [
    {
      "source": "/api/products",
      "destination": "/api/products"
    },
    {
      "source": "/api/settings",
      "destination": "/api/settings"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
